# PostgreSQL connection string used by Prisma and the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret required by GET/POST /api/automation/run-due-schedules.
AUTOMATION_RUNNER_SECRET="replace-with-a-long-random-secret"

# Vercel Cron sends this as a Bearer token. Use the same value as
# AUTOMATION_RUNNER_SECRET unless deployment policy requires otherwise.
CRON_SECRET="replace-with-the-same-long-random-secret"
