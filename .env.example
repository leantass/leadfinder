# PostgreSQL connection string used by Prisma and the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret required by GET/POST /api/automation/run-due-schedules.
AUTOMATION_RUNNER_SECRET=""

# Vercel Cron sends this as a Bearer token. Use the same value as
# AUTOMATION_RUNNER_SECRET (required by the current Vercel Cron implementation).
CRON_SECRET=""

# Single private operator. No public registration or multiuser accounts.
LEADFINDER_ADMIN_USER=""
# scrypt$131072$8$1$<16-byte salt as 32 hex characters>$<64-byte hash as 128 hex characters>
LEADFINDER_ADMIN_PASSWORD_HASH=""
# Independent from the runner secret: 32 random bytes encoded as 64 hex characters.
LEADFINDER_SESSION_SECRET=""
LEADFINDER_RATE_LIMIT_SECRET=""
# Own Node only: enable behind an exclusive proxy that overwrites x-leadfinder-client-ip.
LEADFINDER_TRUST_PROXY="false"
# Exact browser origin, without trailing slash. HTTPS required in production.
LEADFINDER_APP_ORIGIN="http://localhost:3000"
